    "client": ["dev.kizuna.kpabs3d.client.ContainerSwingClient"]
  },
  "mixins": ["kpa_bs3d_swing.mixins.json"],
  "depends": {
    "java": ">=17",
    "minecraft": "1.20.1",
    "fabricloader": ">=0.16.10",
    "fabric-api": ">=0.92.3+1.20.1",
    "backpack_storage_3d": "0.1.0-SNAPSHOT",
    "backpack_storage_3d_client": "0.1.0-SNAPSHOT",
    "kizuna_players_animation": "0.1.0-SNAPSHOT"
  }
}
