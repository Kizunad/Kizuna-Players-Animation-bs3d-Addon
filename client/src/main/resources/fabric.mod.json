{
  "schemaVersion": 1,
  "id": "kpa_bs3d_swing",
  "version": "${version}",
  "name": "KPA BS3D Swing Addon",
  "description": "让 BS3D 容器跟随 Players-Animation 玩家骨骼和移动摆动",
  "environment": "client",
  "authors": ["Kizunad"],
  "license": "MIT",
  "custom": {
    "bs3d:item_registries": ["bs3d/kpa_bs3d_swing/items.txtpb"]
